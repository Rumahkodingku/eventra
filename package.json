{
  "name": "eventra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@eventra/web",
    "build": "turbo run build --filter=@eventra/web",
    "start": "turbo run start --filter=@eventra/web",
    "lint": "turbo run lint --filter=@eventra/web",
    "typecheck": "turbo run typecheck --filter=@eventra/web",
    "test": "turbo run test --filter=@eventra/web",
    "test:run": "turbo run test:run --filter=@eventra/web",
    "test:e2e": "turbo run test:e2e --filter=@eventra/web",
    "test:e2e:firefox": "turbo run test:e2e:firefox --filter=@eventra/web",
    "format": "turbo run format --filter=@eventra/web",
    "format:check": "turbo run format:check --filter=@eventra/web",
    "openapi:lint": "redocly lint apps/api/openapi/openapi.yaml",
    "api-client:generate": "openapi-typescript apps/api/openapi/openapi.yaml -o packages/api-client/src/generated/schema.ts",
    "api-client:typecheck": "npm --workspace @eventra/api-client run typecheck",
    "openapi:contract": "node scripts/openapi-contract-test.mjs",
    "openapi:breaking": "node scripts/openapi-breaking.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "^2.77.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "turbo": "2.11.10",
    "yaml": "^2.8.1"
  }
}
